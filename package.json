{
  "name": "syntools",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "homepage": "https://github.com/synvek/syntools",
  "repository": {
    "type": "git",
    "url": "https://github.com/synvek/syntools.git"
  },
  "author": "synvek",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/synvek/syntools/issues"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/fetch-ffmpeg-core.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-ffmpeg-core.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "BASE_PATH=/syntools/ SITE_URL=https://synvek.github.io/syntools pnpm build",
    "preview": "vite preview",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg-core.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-bundle-size.mjs",
    "e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
