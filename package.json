{
  "name": "syntools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-bundle-size.mjs",
    "e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.9.1",
    "chinese-conv": "^4.0.0",
    "codejar": "^4.3.0",
    "cron-parser": "^5.10.0",
    "csso": "^5.0.5",
    "diff": "^8.0.4",
    "dompurify": "^3.4.14",
    "fast-xml-parser": "^5.11.1",
    "gifuct-js": "^2.1.2",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.0",
    "js-beautify": "^2.0.3",
    "js-md5": "^0.8.3",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "katex": "^0.18.5",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.3.289",
    "pinyin-pro": "^3.29.3",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.3",
    "smol-toml": "^1.8.0",
    "sql-formatter": "^15.8.2",
    "ua-parser-js": "^2.0.10",
    "yaml": "^2.9.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/csso": "^5.0.5",
    "@types/js-beautify": "^1.14.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/prismjs": "^1.26.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
